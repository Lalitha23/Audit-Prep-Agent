# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
#   Copy this file to .streamlit/secrets.toml and fill in your keys.
#   secrets.toml is gitignored — never commit real keys.
#
# STREAMLIT CLOUD DEPLOYMENT
#   Do NOT upload secrets.toml. Instead, paste each key into the Secrets
#   manager in your app's dashboard:
#   App dashboard → Settings → Secrets → paste TOML content
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY    = "sk-..."
